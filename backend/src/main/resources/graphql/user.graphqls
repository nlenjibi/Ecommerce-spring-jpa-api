enum Role {
    USER
    ADMIN
    SELLER
}

type User {
    id: ID!
    email: String!
    username: String!
    firstName: String!
    lastName: String!
    fullName: String!
    phoneNumber: String
    role: Role!
    isActive: Boolean!
    createdAt: DateTime!
    updatedAt: DateTime!
}

type UserPage {
    content: [User!]!
    pageInfo: PageInfo!
}

type AdminDashboard {
    totalUsers: Long!
    totalProducts: Long!
    totalOrders: Long!
    totalRevenue: BigDecimal!
    pendingOrders: Long!
    activeUsers: Long!
    lowStockProducts: Long!
}

input UserCreateInput {
    email: String!
    username: String!
    password: String!
    firstName: String!
    lastName: String!
    phoneNumber: String
    role: Role!
}

input UserUpdateInput {
    email: String
    username: String
    firstName: String
    lastName: String
    phoneNumber: String
}

input UserFilterInput {
    search: String
    role: Role
    active: Boolean
    emailVerified: Boolean
    createdAfter: DateTime
    createdBefore: DateTime
    phoneNumber: String
    name: String
}

extend type Query {
    user(id: ID!): User
    users(pagination: PageInput, filter: UserFilterInput): UserPage!
    currentUser: User
    adminDashboard: AdminDashboard!
}

extend type Mutation {
    createUser(input: UserCreateInput!): User!
    updateUser(id: ID!, input: UserUpdateInput!): User!
    deleteUser(id: ID!): Boolean!
}
